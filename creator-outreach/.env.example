# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Shown in the "from" line and signed at the bottom of every email
SENDER_NAME=Your Name

# What you're actually pitching (kept honest in the template - see templates/*.txt)
PRODUCT_NAME=Your Digital Product

# Local path to the real PDF/file attached to every pitch email
PRODUCT_PREVIEW_PATH=assets/listen_first_preview.pdf

# Sending limits / cadence
DAILY_SEND_LIMIT=20
FOLLOWUP_AFTER_DAYS=7
MAX_TOUCHES=2

# SQLite file storing leads, send history and unsubscribes
DB_PATH=leads.db
