# Copy to .env for local runs. In GitHub Actions these are set as repo secrets instead
# (Settings -> Secrets and variables -> Actions) with the same names.

ANTHROPIC_API_KEY=

# One-time OAuth setup: run scripts/get_youtube_refresh_token.py locally after
# creating an OAuth client in Google Cloud Console (see README).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Only needed if tts.provider = elevenlabs in config.yaml
ELEVENLABS_API_KEY=
