# Google Places API key (requires billing enabled on the GCP project)
GOOGLE_PLACES_API_KEY=

SENDER_NAME=Your Name

# Where generated demo pages get written locally
DEMO_OUTPUT_DIR=demos

# Public base URL the demo pages will be reachable at once hosted
# (e.g. GitHub Pages: https://<user>.github.io/<repo>/biz-outreach/demos)
DEMO_BASE_URL=https://example.com/demos

# Sending limits / cadence
DAILY_SEND_LIMIT=20
FOLLOWUP_AFTER_DAYS=7
MAX_TOUCHES=2

DB_PATH=leads.db
